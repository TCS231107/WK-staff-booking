# weKnow Staff Bookings — configuration
# Copy this file to ".env" and fill in what you need. Lines starting with # are ignored.
# Every value here can also be passed as a normal environment variable; the shell wins over .env.

# --- basics ---
# PORT=4173
# WK_APP_URL=https://bookings.weknowinc.com      # public URL used in invitation emails
# WK_ADMIN_CONTACT=it@weknowinc.com              # shown on the sign-in screen for access / password help
# WK_DATA_DIR=/var/lib/weknow-bookings           # where bookings.json, users.json, backups live (default: ./data)

# --- first admin account (only read on the very first run) ---
# WK_ADMIN_PASSWORD=change-me-on-first-login

# --- storage: Postgres instead of JSON files ---
# Set this and the app stores everything in the database and writes nothing to
# disk (so no persistent disk is needed). Leave it unset to keep using files.
# Supabase: use the SESSION POOLER string, not "Direct connection" - the direct
# host is IPv6-only and most hosts can't reach it. Supabase -> Connect -> Session pooler.
# WK_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# WK_PG_SCHEMA=wk                                # schema to use (default "wk"); the test suite overrides this

# --- running behind the weknowinc.com Next.js site ---
# Set by scripts/start-with-staff.mjs at the repo root; only needed if you start
# this server yourself and still want it served at weknowinc.com/staff.
# WK_BASE_PATH=/staff                            # mount point: strips the prefix and rebases the app's URLs
# WK_BIND=127.0.0.1                              # loopback only, reachable through the site's proxy
# WK_SECURE_COOKIES=1                            # TLS terminates at the proxy, so force Secure on the session cookie

# --- HTTPS (recommended once this is reachable beyond localhost) ---
# Generate a self-signed pair for testing:
#   openssl req -x509 -newkey rsa:2048 -nodes -keyout data/tls.key -out data/tls.crt -days 365 -subj "/CN=localhost"
# WK_TLS_CERT=data/tls.crt
# WK_TLS_KEY=data/tls.key

# --- sending invitation emails (SMTP over TLS, port 465) ---
# Without these, an invite just shows the temporary password on screen + a preview link.
# WK_SMTP_HOST=smtp.yourprovider.com
# WK_SMTP_PORT=465
# WK_SMTP_USER=no-reply@weknowinc.com
# WK_SMTP_PASS=your-smtp-password
# WK_SMTP_FROM=weKnow Staff Bookings <no-reply@weknowinc.com>
